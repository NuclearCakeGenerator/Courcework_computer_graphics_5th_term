{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build the document inside Docker (Latexmk)",
            "type": "shell",
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-v",
                "${fileDirname}:/data",
                "texlive/texlive:latest",
                "latexmk",
                "-pdf",
                "-interaction=nonstopmode",
                "-synctex=1",
                "-output-directory=build",
                "-cd",
                "/data/${fileBasename}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        }
    ]
}
