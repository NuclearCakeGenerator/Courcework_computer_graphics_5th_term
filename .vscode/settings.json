{
  "latex-workshop.latex.tools": [
    {
      "name": "docker-latexmk",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-v",
        "${workspaceRoot}:/data",
        "-w",
        "/data",
        "qmcgaw/latexdevcontainer:latest-minimal",
        "latexmk",
        "-pdf",
        "-interaction=nonstopmode",
        "-synctex=1",
        "-output-directory=build",
        "%DOCFILE%"
      ],
      "env": {}
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "Docker Latexmk",
      "tools": [
        "docker-latexmk"
      ]
    }
  ],
  // Automatically compile on save
  "latex-workshop.latex.autoBuild.run": "onSave",
  // Open the PDF inside a VS Code tab
  "latex-workshop.view.pdf.viewer": "tab"
}
